# systemd unit for the hush-hush secret store.
#
# Install:
#   sudo install -m 0644 deploy/hush-hush.service /etc/systemd/system/hush-hush.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hush-hush
#
# Full walkthrough: deploy/README.md
#
# Requires systemd >= 247 for LoadCredential= (Debian 11+, Ubuntu 22.04+,
# RHEL 9+). Check with `systemctl --version`. On older systemd, see the
# EnvironmentFile= alternative in the [Service] section below.

[Unit]
Description=hush-hush secret store
Documentation=https://github.com/cjunks94/hush-hush/blob/main/deploy/README.md
# Only listens on loopback, so it doesn't need to wait for network-online.
After=network.target

[Service]
Type=simple
# Dedicated system user. Agents must NEVER run as this user (or root): anyone
# who is `hush` can read the database and the loaded master key directly and
# skip tokens, prefixes and the audit log entirely.
User=hush
Group=hush

# "serve" is also the default with no subcommand; spelled out for clarity.
ExecStart=/usr/local/bin/hush-hush serve
Restart=on-failure
RestartSec=2s

# ---- configuration (non-secret values only) --------------------------------
# Anything in Environment= is visible to every local user via
# `systemctl show hush-hush`, so the master key must never go here.
Environment=DB_PATH=/var/lib/hush/hush.db
# Loopback only. Caddy on the same host terminates TLS and proxies here.
Environment=LISTEN_ADDR=127.0.0.1:8080
# Caddy is on the same host, so trust its X-Forwarded-For for the client IP
# (used for the audit log and the per-IP failed-auth rate limit). Only
# honoured when the TCP peer is loopback.
Environment=TRUST_PROXY_HEADERS=true
# Defaults shown; uncomment to change.
#Environment=RATE_LIMIT_PER_MINUTE=60
#Environment=UNAUTH_RATE_LIMIT_PER_MINUTE=10

# ---- master key -------------------------------------------------------------
# systemd copies /etc/hush/master_key (root:root 0600) into a private,
# non-swappable credentials directory that only this service can read, and
# exposes it as $CREDENTIALS_DIRECTORY/master_key. hush-hush prefers that file
# over the MASTER_KEY env var when it is present.
LoadCredential=master_key:/etc/hush/master_key

# Alternative for systemd < 247 (no LoadCredential=): comment out the line
# above and uncomment the one below. /etc/hush/hush.env must be root:root 0600
# and contain a single line:
#     MASTER_KEY=<base64 of 32 random bytes>
# systemd reads the file as root before dropping privileges, so the hush user
# never needs read access to it. The key then lives in the process environment
# (readable by root and by the hush user via /proc/<pid>/environ), which is
# slightly weaker than a credential but still keeps it out of the unit file.
#EnvironmentFile=/etc/hush/hush.env

# ---- filesystem --------------------------------------------------------------
# Creates /var/lib/hush owned by hush:hush and resets it to 0700 on every start.
StateDirectory=hush
StateDirectoryMode=0700
# New files (DB, -wal, -shm) are created owner-only.
UMask=0077
# Whole filesystem read-only except the state directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/hush
# /home, /root and /run/user are invisible.
ProtectHome=true
PrivateTmp=true
# Minimal /dev (null, zero, urandom, ...), no physical devices.
PrivateDevices=true

# ---- privileges ----------------------------------------------------------------
NoNewPrivileges=true
# Empty = drop every capability. Port 8080 needs none.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
# Clean up any SysV IPC objects the user leaves behind.
RemoveIPC=true

# ---- kernel / system surface ---------------------------------------------------
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other processes in /proc are hidden from the service.
ProtectProc=invisible
# IPv4/IPv6 for the listener, AF_UNIX for journald/syslog.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Safe for Go: the runtime never maps writable+executable memory.
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
# The standard allow-list for ordinary services; the Go runtime fits in it.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
