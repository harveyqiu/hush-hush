# Used by compose.traefik.yaml. Copy to .env and edit.

# Makes plain `docker compose ...` load the Traefik overlay too, so every
# command (up, exec, logs) works without repeating -f flags.
COMPOSE_FILE=compose.yaml:compose.traefik.yaml

# Public hostname Traefik routes to hush-hush.
HUSH_HOST=secrets.example.com

# The external Docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik

# Traefik's address on that network, the only peer allowed to set
# X-Forwarded-For. Pin Traefik to a fixed IP (see docs/docker.md) and put it
# here, or use the whole network's subnet if only Traefik and trusted
# services are attached to it.
TRAEFIK_TRUSTED=172.30.0.2

# Who may open the web UI and /v1/admin (comma-separated CIDRs): your VPN,
# office or home address. Agents only need /v1/secrets, which stays open.
HUSH_ADMIN_ALLOW=192.0.2.10/32,10.8.0.0/24

# Match your Traefik static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
